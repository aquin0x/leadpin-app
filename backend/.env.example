PORT=4000
NODE_ENV=development

# Ek CORS origin'leri (virgülle ayrılmış, örn. https://app.ugra.io)
CORS_ORIGINS=

# Aynı anda çalışacak scrape işi sayısı (varsayılan 1)
SCRAPER_CONCURRENCY=1

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Puppeteer / Scraper
# false => tarayıcı görünür açılır (debug), true => headless
PUPPETEER_HEADLESS=true

# Short link redirect (ugra.io/{shortId} tıklamaları sonrasında yönlenecek URL)
SHORT_LINK_REDIRECT_URL=https://ugra.io

# WhatsApp Campaign (opsiyonel - Termux/mobil proxy için)
# WHATSAPP_PROXY_HOST=192.168.43.1
# WHATSAPP_PROXY_PORT=8080
